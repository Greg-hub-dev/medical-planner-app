# Copie ce fichier en .env.local (dev) ou renseigne ces variables dans Vercel.
# ⚠️ Ne committe jamais .env.local (déjà ignoré par .gitignore).

# --- Base hébergée (déploiement Vercel uniquement) -------------------------
# Si TURSO_DATABASE_URL est défini, l'application utilise Turso au lieu du
# fichier SQLite local. Laisse ces variables VIDES en local / dans Electron.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Protection du site en ligne -------------------------------------------
# Si APP_PASSWORD est défini, le site demande une authentification HTTP Basic.
# N'importe quel identifiant convient, sauf si APP_USER est précisé.
APP_PASSWORD=
APP_USER=

# --- Invitations calendrier par email (optionnel) ---------------------------
EMAIL_USER=
EMAIL_APP_PASSWORD=
NEXTAUTH_URL=
